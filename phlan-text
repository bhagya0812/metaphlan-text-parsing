#!/bin/bash

#remove the first 4 rows of metaphlan outptut
awk -F '\t' '
    NR <= 4 { next }  # 1. Skip the first 4 rows
    {
        # 2. Delete column 2 and shift everything left
        for (i = 2; i < NF; i++) {
            $i = $(i+1)
        }
        NF--  # Reduce the total column count by 1
        
        # 3. Print the row
        print
    }
' "$file".tsv > "${file}-modified.tsv"

#split that single column of classification into 7 columns and keep rel_ab
awk -F '\\|' -v OFS = '\t' '{split($1, tax, "|"; $1= tax[1] OFS tax[2] OFS tax[3] OFS tax[4] OFS tax[5] OFS tax[6] OFS tax[7]}' "$file-modified.tsv" > "${file-modified%}-split.tsv" &&

#provide uniform column headers 
awk -F '\t' -v OFS='\t' 'NR==1 {print "Kingdom", "Phylum", "Class", "Order", "Family", "Genus", "Species", "rel_ab";next}{print}' "$file-split.tsv" > "${file}-split-renamed.tsv" &&

#extract at required classification level: $1 is Kingdom, $2 is Phylum, $3 is Class and so on
awk -F '\t' 'NR == 1 || $6 != ""' "$file-split-renamed.tsv" > "${file}-split-renamed-genus.tsv"
